{
	"schemaVersion": 1,
	"id": "elevators",
	"version": "${version}",
	"name": "BetterVanilla+",
	"description": "Vanilla-style features: Elevators, cauldron conversions, beacon bonuses, and player and villager trade commands.",
	"authors": [
		"Elevators Fabric contributors"
	],
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"it.elevators.ElevatorsMod"
		],
		"client": [
			"it.elevators.ElevatorsClient"
		],
		"modmenu": [
			"it.elevators.client.BetterVanillaModMenuIntegration"
		]
	},
	"mixins": [
		"elevators.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
